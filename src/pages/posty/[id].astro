---
import Layout from '../../layouts/Layout.astro';
import { getPostById, type Post } from '../../lib/db';

const { id } = Astro.params;

if (!id) {
  return Astro.redirect('/');
}

const post = await getPostById(Astro.locals, id);

if (!post) {
  return Astro.redirect('/?not-found=1');
}

// Formatowanie daty po polsku
function formatDate(dateStr: string) {
  try {
    const d = new Date(dateStr);
    return d.toLocaleDateString('pl-PL', {
      day: 'numeric',
      month: 'long',
      year: 'numeric',
      hour: '2-digit',
      minute: '2-digit',
    });
  } catch {
    return dateStr;
  }
}

// Parsowanie wszystkich zdjęć
function parseImages(jsonStr: string | null): string[] {
  if (!jsonStr) return [];
  try {
    const parsed = JSON.parse(jsonStr);
    return Array.isArray(parsed) ? parsed : [];
  } catch {
    return [];
  }
}

const images = parseImages(post.images_json);
const isFacebook = post.source === 'facebook';
const postTitle = post.title || (isFacebook ? 'Relacja z profilu Facebook' : 'Komunikat 3 SDH "Wenedzi"');
---

<Layout title={`${postTitle} | 3 SDH »Wenedzi«`} description={post.content.slice(0, 160)}>
  
  <article class="max-w-4xl mx-auto px-4 sm:px-6 py-10 sm:py-14 space-y-8">
    
    <!-- Nawigacja powrotu / Breadcrumb -->
    <nav class="flex items-center justify-between text-xs sm:text-sm text-slate-500 pb-4 border-b border-slate-200">
      <a
        href="/"
        class="inline-flex items-center gap-2 text-emerald-800 hover:text-emerald-700 font-bold transition-colors group"
      >
        <span class="group-hover:-translate-x-1 transition-transform">&larr;</span>
        <span>Wróć do strony głównej</span>
      </a>

      <div class="flex items-center gap-2">
        <span class="text-slate-400">Aktualności</span>
        <span>/</span>
        <span class="text-slate-700 font-medium truncate max-w-[180px] sm:max-w-xs">{postTitle}</span>
      </div>
    </nav>

    <!-- Nagłówek wpisu -->
    <header class="space-y-4">
      <div class="flex items-center gap-3 flex-wrap">
        {isFacebook ? (
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-blue-50 text-blue-700 border border-blue-200">
            <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
              <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
            </svg>
            Facebook
          </span>
        ) : (
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-emerald-50 text-emerald-800 border border-emerald-200">
            🌲 Komunikat Drużyny
          </span>
        )}

        {Boolean(post.is_pinned) && (
          <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-bold bg-amber-100 text-amber-800 border border-amber-200">
            📌 Przypięte
          </span>
        )}

        <time class="text-xs text-slate-400">
          {formatDate(post.created_at)}
        </time>
      </div>

      <h1 class="text-2xl sm:text-4xl font-extrabold text-slate-900 tracking-tight leading-snug">
        {postTitle}
      </h1>

      <div class="flex items-center justify-between text-xs sm:text-sm text-slate-500 pt-1">
        <div class="flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-emerald-600"></span>
          <span>Autor: <strong class="text-slate-800">{post.author_name || (isFacebook ? '3 SDH Wenedzi (Facebook)' : 'Drużynowy')}</strong></span>
        </div>

        {isFacebook && post.fb_permalink && (
          <a
            href={post.fb_permalink}
            target="_blank"
            rel="noopener noreferrer"
            class="text-blue-600 hover:text-blue-800 font-semibold hover:underline inline-flex items-center gap-1"
          >
            <span>Oryginalny post na FB</span>
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
          </a>
        )}
      </div>
    </header>

    <!-- Pełna treść posta -->
    <div class="bg-white rounded-2xl p-6 sm:p-10 border border-slate-200 shadow-sm">
      <div class="text-slate-800 text-base sm:text-lg leading-relaxed whitespace-pre-line font-normal space-y-4">
        {post.content}
      </div>
    </div>

    <!-- WSZYSTKIE ZDJĘCIA (GALERIA Z LIGHTBOXEM) -->
    {images.length > 0 && (
      <section class="space-y-4">
        <div class="flex items-center justify-between">
          <h2 class="text-xl font-bold text-slate-900 flex items-center gap-2">
            <span>📷 Galeria zdjęć</span>
            <span class="text-xs px-2.5 py-0.5 rounded-full bg-slate-100 text-slate-600 font-semibold">
              {images.length} {images.length === 1 ? 'zdjęcie' : images.length < 5 ? 'zdjęcia' : 'zdjęć'}
            </span>
          </h2>
          <span class="text-xs text-slate-400">Kliknij na zdjęcie, aby powiększyć</span>
        </div>

        <div class={`grid gap-4 ${images.length === 1 ? 'grid-cols-1' : images.length === 2 ? 'grid-cols-1 sm:grid-cols-2' : 'grid-cols-1 sm:grid-cols-2 lg:grid-cols-3'}`}>
          {images.map((imgUrl, idx) => (
            <div class="relative aspect-video bg-slate-900 rounded-2xl overflow-hidden group border border-slate-200 cursor-pointer shadow-sm hover:shadow-md transition-all">
              <img
                src={imgUrl}
                alt={`Zdjęcie ${idx + 1} do wpisu`}
                loading="lazy"
                class="zoomable-image w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
              />
              <div class="absolute inset-0 bg-slate-950/20 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center pointer-events-none">
                <span class="px-3 py-1.5 rounded-full bg-slate-950/80 text-white text-xs font-semibold backdrop-blur-sm shadow flex items-center gap-1.5">
                  <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v6m3-3H7" />
                  </svg>
                  <span>Powiększ</span>
                </span>
              </div>
            </div>
          ))}
        </div>
      </section>
    )}

    <!-- Dolna belka akcji -->
    <footer class="pt-6 border-t border-slate-200 flex flex-wrap items-center justify-between gap-4">
      <a
        href="/"
        class="px-5 py-2.5 rounded-xl bg-slate-900 hover:bg-slate-800 text-white text-sm font-semibold transition-all inline-flex items-center gap-2"
      >
        <span>&larr; Wróć do aktualności</span>
      </a>

      {isFacebook && (
        <a
          href={post.fb_permalink || 'https://www.facebook.com/wenedzi/'}
          target="_blank"
          rel="noopener noreferrer"
          class="px-5 py-2.5 rounded-xl bg-blue-50 hover:bg-blue-100 text-blue-700 text-sm font-bold border border-blue-200 transition-all inline-flex items-center gap-2"
        >
          <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
            <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
          </svg>
          <span>Skomentuj na Facebooku</span>
        </a>
      )}
    </footer>

  </article>

</Layout>
