---
import Layout from '../../layouts/Layout.astro';
import { getAllPosts, type Post } from '../../lib/db';

let posts: Post[] = [];
try {
  posts = await getAllPosts(Astro.locals);
} catch (e) {
  // DB query may fail if table not initialized yet
}
---

<Layout title="Panel Administratora | 3 SDH »Wenedzi«" description="Zarządzanie postami i synchronizacją strony 3 SDH Wenedzi.">
  <div class="bg-slate-950 text-white py-10 border-b border-slate-800">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 flex items-center justify-between flex-wrap gap-4">
      <div>
        <div class="inline-flex items-center gap-2 text-xs font-semibold text-emerald-400 mb-1">
          <a href="/" class="hover:underline">Strona Główna</a>
          <span>/</span>
          <span class="text-slate-400">Administracja</span>
        </div>
        <h1 class="text-2xl sm:text-3xl font-extrabold tracking-tight">
          🔒 Panel Administratora 3 SDH "Wenedzi"
        </h1>
      </div>
      <button
        id="logout-btn"
        type="button"
        class="hidden px-3.5 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-300 text-xs font-semibold transition-colors"
      >
        Wyloguj się
      </button>
    </div>
  </div>

  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-10">
    
    <!-- EKRAN LOGOWANIA (jeśli nie zalogowany) -->
    <div id="login-section" class="max-w-md mx-auto bg-white rounded-2xl p-6 sm:p-8 border border-slate-200 shadow-lg space-y-6">
      <div class="text-center space-y-2">
        <div class="w-12 h-12 rounded-2xl bg-emerald-950 text-white flex items-center justify-center font-extrabold text-xl mx-auto shadow-inner">
          3
        </div>
        <h2 class="text-xl font-bold text-slate-900">Dostęp dla kadry drużyny</h2>
        <p class="text-xs text-slate-500">
          Wpisz hasło administratora, aby zarządzać postami i synchronizacją z Facebookiem.
        </p>
      </div>

      <form id="login-form" class="space-y-4">
        <div>
          <label for="admin-password" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1">
            Hasło dostępu:
          </label>
          <input
            type="password"
            id="admin-password"
            placeholder="Domyślne hasło: wenedzi3"
            required
            class="w-full px-4 py-2.5 rounded-xl border border-slate-300 text-sm focus:outline-none focus:ring-2 focus:ring-emerald-700"
          />
        </div>
        <p id="login-error" class="hidden text-xs text-red-600 font-semibold"></p>
        <button
          type="submit"
          class="w-full py-2.5 rounded-xl bg-emerald-800 hover:bg-emerald-700 text-white font-bold text-sm transition-colors shadow-md"
        >
          Zaloguj się
        </button>
        <p class="text-[11px] text-slate-400 text-center">
          Domyślne hasło startowe: <code class="font-mono bg-slate-100 px-1 py-0.5 rounded text-slate-700">wenedzi3</code>
        </p>
      </form>
    </div>

    <!-- WŁAŚCIWY DASHBOARD ADMINISTRATORA (ukryty do zalogowania) -->
    <div id="dashboard-section" class="hidden space-y-10">
      
      <!-- POWIADOMIENIA / TOAST -->
      <div id="admin-alert" class="hidden p-4 rounded-xl text-sm font-semibold transition-all"></div>

      <!-- KAFELKI AKCJI: DODAWANIE POSTA + SYNCHRONIZACJA FB -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
        
        <!-- FORMULARZ: NOWY POST NA STRONĘ -->
        <div class="bg-white rounded-2xl p-6 sm:p-8 border border-slate-200 shadow-sm space-y-5">
          <div class="flex items-center gap-3 pb-3 border-b border-slate-100">
            <span class="text-2xl">📝</span>
            <div>
              <h2 class="text-lg font-bold text-slate-900">Dodaj post ekskluzywnie na stronę</h2>
              <p class="text-xs text-slate-500">Pojawi się na samej górze strony głównej z oznaczeniem drużyny</p>
            </div>
          </div>

          <form id="create-post-form" class="space-y-4">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              <div>
                <label for="post-source" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1">
                  Typ / Źródło wpisu:
                </label>
                <select
                  id="post-source"
                  class="w-full px-3 py-2 rounded-xl border border-slate-300 text-sm focus:outline-none focus:ring-2 focus:ring-emerald-700 font-medium"
                >
                  <option value="local">🌲 Komunikat Drużyny (Lokalny)</option>
                  <option value="facebook">📘 Post z profilu Facebook (@wenedzi)</option>
                </select>
              </div>

              <div>
                <label for="post-title" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1">
                  Tytuł posta (opcjonalny):
                </label>
                <input
                  type="text"
                  id="post-title"
                  placeholder="np. Zbiórka w najbliższą sobotę!"
                  class="w-full px-4 py-2 rounded-xl border border-slate-300 text-sm focus:outline-none focus:ring-2 focus:ring-emerald-700"
                />
              </div>
            </div>

            <div id="fb-permalink-container" class="hidden">
              <label for="post-permalink" class="block text-xs font-bold uppercase tracking-wider text-blue-700 mb-1">
                Link do posta na Facebooku (permalink):
              </label>
              <input
                type="url"
                id="post-permalink"
                placeholder="https://www.facebook.com/wenedzi/posts/..."
                class="w-full px-4 py-2 rounded-xl border border-blue-300 text-xs font-mono focus:outline-none focus:ring-2 focus:ring-blue-600"
              />
            </div>

            <div class="grid grid-cols-2 gap-3">
              <div>
                <label for="post-author" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1">
                  Autor:
                </label>
                <input
                  type="text"
                  id="post-author"
                  value="Drużynowy"
                  class="w-full px-3 py-2 rounded-xl border border-slate-300 text-sm focus:outline-none focus:ring-2 focus:ring-emerald-700"
                />
              </div>
              <div class="flex items-center pt-5">
                <label class="flex items-center gap-2 text-xs font-bold text-slate-700 cursor-pointer select-none">
                  <input type="checkbox" id="post-pinned" class="w-4 h-4 text-emerald-800 rounded border-slate-300 focus:ring-emerald-700" />
                  <span>📌 Przypnij na górze</span>
                </label>
              </div>
            </div>

            <div>
              <label for="post-content" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1">
                Treść posta: *
              </label>
              <textarea
                id="post-content"
                rows="5"
                required
                placeholder="Napisz treść ogłoszenia, szczegóły wyjazdu, godziny zbiórek..."
                class="w-full px-4 py-2.5 rounded-xl border border-slate-300 text-sm focus:outline-none focus:ring-2 focus:ring-emerald-700"
              ></textarea>
            </div>

            <!-- WGRYWANIE ZDJĘĆ NA DYSK GOOGLE -->
            <div class="p-4 rounded-2xl bg-emerald-50/60 border-2 border-dashed border-emerald-300 space-y-3">
              <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                  <span class="text-xl">☁️</span>
                  <div>
                    <span class="text-xs font-extrabold uppercase tracking-wider text-emerald-950 block">
                      Wgraj zdjęcia na Dysk Google
                    </span>
                    <span class="text-[11px] text-slate-500">
                      Trafią do folderu na Dysku Współdzielonym 3 SDH Wenedzi
                    </span>
                  </div>
                </div>
                <span class="text-[10px] font-bold bg-emerald-200/80 text-emerald-900 px-2 py-0.5 rounded-full">
                  Google Drive API
                </span>
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-1">
                <div>
                  <label for="drive-upload-date" class="block text-[11px] font-bold text-slate-700 mb-1">
                    Data folderu (RRRR.MM.DD):
                  </label>
                  <input
                    type="text"
                    id="drive-upload-date"
                    placeholder="2026.11.11 lub 2026.11"
                    class="w-full px-3 py-2 rounded-xl border border-slate-300 text-xs font-mono bg-white focus:outline-none focus:ring-2 focus:ring-emerald-700"
                  />
                  <span class="text-[10px] text-slate-400">Dopasowuje folder zawierający tę datę lub tworzy nowy.</span>
                </div>

                <div>
                  <label for="drive-upload-files" class="block text-[11px] font-bold text-slate-700 mb-1">
                    Wybierz pliki ze zdjęciami:
                  </label>
                  <input
                    type="file"
                    id="drive-upload-files"
                    multiple
                    accept="image/*"
                    class="w-full text-xs text-slate-600 file:mr-2 file:py-1.5 file:px-3 file:rounded-xl file:border-0 file:text-xs file:font-bold file:bg-emerald-700 file:text-white hover:file:bg-emerald-800 cursor-pointer"
                  />
                </div>
              </div>

              <div class="flex items-center justify-between pt-1">
                <button
                  type="button"
                  id="drive-upload-btn"
                  class="px-4 py-2 rounded-xl bg-emerald-800 hover:bg-emerald-700 text-white font-bold text-xs transition-all shadow-sm flex items-center gap-1.5 cursor-pointer disabled:opacity-50"
                >
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12" />
                  </svg>
                  <span id="drive-upload-btn-text">Wgraj na Dysk Google</span>
                </button>
              </div>

              <div id="drive-upload-status" class="hidden text-xs"></div>

              <div id="drive-preview-list" class="hidden pt-2 border-t border-emerald-200/80 flex flex-wrap gap-2"></div>
            </div>

            <div>
              <label for="post-images" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1">
                Linki do zdjęć w poście (po jednym w linii):
              </label>
              <textarea
                id="post-images"
                rows="2"
                placeholder="https://... lub /api/drive-image?id=..."
                class="w-full px-4 py-2 rounded-xl border border-slate-300 text-xs font-mono focus:outline-none focus:ring-2 focus:ring-emerald-700"
              ></textarea>
              <span class="text-[11px] text-slate-400">Zdjęcia z Dysku Google pojawią się tu automatycznie po wgraniu. Możesz też wklejać linki ręcznie.</span>
            </div>

            <button
              type="submit"
              id="submit-post-btn"
              class="w-full py-2.5 rounded-xl bg-emerald-800 hover:bg-emerald-700 text-white font-bold text-sm transition-colors shadow-md"
            >
              Opublikuj post na stronie głównej
            </button>
          </form>
        </div>

        <!-- SYNCHRONIZACJA Z FACEBOOKIEM (JEDEN PRZYCISK) -->
        <div class="bg-white rounded-2xl p-6 sm:p-8 border border-slate-200 shadow-sm space-y-5 flex flex-col justify-between">
          <div class="space-y-4">
            <div class="flex items-center gap-3 pb-3 border-b border-slate-100">
              <div class="w-10 h-10 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center shadow-xs">
                <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
                  <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
                </svg>
              </div>
              <div>
                <h2 class="text-lg font-bold text-slate-900">Synchronizacja z Facebookiem</h2>
                <p class="text-xs text-slate-500">Oficjalny fanpage 3 SDH "Wenedzi" (@wenedzi)</p>
              </div>
            </div>

            <div class="p-4 rounded-xl bg-blue-50/80 border border-blue-200 text-xs text-blue-950 space-y-2 leading-relaxed">
              <p class="font-bold text-blue-900 flex items-center gap-1.5">
                <span>⚡</span>
                <span>Automatyczne pobieranie najnowszych wpisów</span>
              </p>
              <p>
                Kliknij przycisk poniżej, aby sprawdzić <strong>5 ostatnich postów z Facebooka wraz z datami i wszystkimi zdjęciami</strong>, zapisać je w bazie danych i zaktualizować stronę główną.
              </p>
            </div>
          </div>

          <div class="space-y-3 pt-4">
            <button
              type="button"
              id="sync-fb-btn"
              class="w-full py-3 px-4 rounded-xl bg-blue-600 hover:bg-blue-700 text-white font-bold text-sm transition-all shadow-md hover:shadow-lg flex items-center justify-center gap-2 cursor-pointer"
            >
              <svg id="sync-fb-icon" class="w-4 h-4 fill-current" viewBox="0 0 24 24">
                <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
              </svg>
              <span id="sync-fb-btn-text">Pobierz posty z FB</span>
            </button>

            <div id="fb-sync-status" class="hidden p-3 rounded-xl text-xs font-medium"></div>
          </div>
        </div>

      </div>

      <!-- LISTA POSTÓW W BAZIE I USUWANIE -->
      <div class="bg-white rounded-2xl p-6 sm:p-8 border border-slate-200 shadow-sm space-y-4">
        <div class="flex items-center justify-between">
          <div>
            <h2 class="text-xl font-bold text-slate-900">Posty w bazie danych SQLite (D1)</h2>
            <p class="text-xs text-slate-500">Możesz usuwać wpisy lub sprawdzać stan synchronizacji</p>
          </div>
          <button
            type="button"
            id="refresh-posts-btn"
            class="px-3 py-1.5 rounded-lg bg-slate-100 hover:bg-slate-200 text-xs font-semibold text-slate-700 transition-colors"
          >
            Odśwież listę
          </button>
        </div>

        <div class="overflow-x-auto">
          <table class="w-full text-left text-xs">
            <thead class="bg-slate-50 border-b border-slate-200 text-slate-500 uppercase tracking-wider font-semibold">
              <tr>
                <th class="p-3">Źródło</th>
                <th class="p-3">Tytuł / Treść</th>
                <th class="p-3">Autor</th>
                <th class="p-3">Data</th>
                <th class="p-3 text-right">Akcja</th>
              </tr>
            </thead>
            <tbody id="posts-table-body" class="divide-y divide-slate-100 text-slate-700">
              {posts.map((p) => (
                <tr data-post-id={p.id}>
                  <td class="p-3">
                    {p.source === 'facebook' ? (
                      <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full font-bold bg-blue-50 text-blue-700">
                        Facebook
                      </span>
                    ) : (
                      <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full font-bold bg-emerald-50 text-emerald-800">
                        Lokalny
                      </span>
                    )}
                    {Boolean(p.is_pinned) && (
                      <span class="ml-1 inline-flex items-center px-1.5 py-0.5 rounded bg-amber-100 text-amber-800 font-bold">
                        📌
                      </span>
                    )}
                  </td>
                  <td class="p-3 font-medium max-w-xs truncate">
                    {p.title ? `[${p.title}] ` : ''}
                    {p.content}
                  </td>
                  <td class="p-3 whitespace-nowrap text-slate-500">
                    {p.author_name || '-'}
                  </td>
                  <td class="p-3 whitespace-nowrap text-slate-400">
                    {p.created_at?.slice(0, 10)}
                  </td>
                  <td class="p-3 text-right whitespace-nowrap space-x-2">
                    {p.source === 'local' && (
                      <button
                        type="button"
                        class="edit-post-btn text-emerald-700 hover:text-emerald-900 font-bold hover:underline cursor-pointer"
                        data-id={p.id}
                        data-title={p.title || ''}
                        data-author={p.author_name || ''}
                        data-content={p.content}
                        data-images={p.images_json || ''}
                        data-pinned={p.is_pinned ? '1' : '0'}
                      >
                        Edytuj
                      </button>
                    )}
                    <button
                      type="button"
                      class="delete-post-btn text-red-600 hover:text-red-800 font-bold hover:underline cursor-pointer"
                      data-id={p.id}
                    >
                      Usuń
                    </button>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>

    </div>

  </div>

  <!-- MODAL EDYCJI POSTA LOKALNEGO -->
  <div
    id="edit-modal"
    class="fixed inset-0 z-50 bg-slate-950/80 backdrop-blur-xs hidden items-center justify-center p-4"
  >
    <div class="bg-white rounded-2xl max-w-xl w-full p-6 sm:p-8 border border-slate-200 shadow-2xl space-y-5 max-h-[90vh] overflow-y-auto">
      <div class="flex items-center justify-between pb-3 border-b border-slate-100">
        <h3 class="text-lg font-bold text-slate-900 flex items-center gap-2">
          <span>✏️</span>
          <span>Edycja posta lokalnego</span>
        </h3>
        <button
          type="button"
          id="close-edit-modal-btn"
          class="w-8 h-8 rounded-lg bg-slate-100 hover:bg-slate-200 text-slate-600 flex items-center justify-center font-bold cursor-pointer"
        >
          ✕
        </button>
      </div>

      <form id="edit-post-form" class="space-y-4">
        <input type="hidden" id="edit-post-id" />

        <div>
          <label for="edit-post-title" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1">
            Tytuł posta:
          </label>
          <input
            type="text"
            id="edit-post-title"
            class="w-full px-4 py-2 rounded-xl border border-slate-300 text-sm focus:outline-none focus:ring-2 focus:ring-emerald-700"
          />
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <div>
            <label for="edit-post-author" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1">
              Autor:
            </label>
            <input
              type="text"
              id="edit-post-author"
              class="w-full px-4 py-2 rounded-xl border border-slate-300 text-sm focus:outline-none focus:ring-2 focus:ring-emerald-700"
            />
          </div>
          <div class="flex items-center pt-5">
            <label class="flex items-center gap-2 text-xs font-bold text-slate-700 cursor-pointer">
              <input
                type="checkbox"
                id="edit-post-pinned"
                class="rounded text-emerald-800 focus:ring-emerald-700 w-4 h-4 cursor-pointer"
              />
              <span>📌 Przypnij na górze</span>
            </label>
          </div>
        </div>

        <div>
          <label for="edit-post-content" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1">
            Treść posta: *
          </label>
          <textarea
            id="edit-post-content"
            rows="6"
            required
            class="w-full px-4 py-2.5 rounded-xl border border-slate-300 text-sm focus:outline-none focus:ring-2 focus:ring-emerald-700 font-normal"
          ></textarea>
        </div>

        <div>
          <label for="edit-post-images" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1">
            Linki do zdjęć (po jednym w linii):
          </label>
          <textarea
            id="edit-post-images"
            rows="3"
            placeholder="https://...&#10;https://..."
            class="w-full px-4 py-2 rounded-xl border border-slate-300 text-xs font-mono focus:outline-none focus:ring-2 focus:ring-emerald-700"
          ></textarea>
        </div>

        <div class="flex items-center justify-end gap-3 pt-2">
          <button
            type="button"
            id="cancel-edit-btn"
            class="px-4 py-2 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold text-xs cursor-pointer"
          >
            Anuluj
          </button>
          <button
            type="submit"
            class="px-5 py-2 rounded-xl bg-emerald-800 hover:bg-emerald-700 text-white font-bold text-xs shadow-md cursor-pointer"
          >
            Zapisz zmiany
          </button>
        </div>
      </form>
    </div>
  </div>

  <script>
    const ADMIN_PASS = 'wenedzi3';
    const authStorageKey = 'wenedzi_admin_auth';

    const loginSection = document.getElementById('login-section');
    const dashboardSection = document.getElementById('dashboard-section');
    const loginForm = document.getElementById('login-form');
    const loginError = document.getElementById('login-error');
    const logoutBtn = document.getElementById('logout-btn');

    function checkAuth() {
      const isAuth = sessionStorage.getItem(authStorageKey) === 'true';
      if (isAuth) {
        loginSection?.classList.add('hidden');
        dashboardSection?.classList.remove('hidden');
        logoutBtn?.classList.remove('hidden');
      } else {
        loginSection?.classList.remove('hidden');
        dashboardSection?.classList.add('hidden');
        logoutBtn?.classList.add('hidden');
      }
    }

    if (loginForm) {
      loginForm.addEventListener('submit', (e) => {
        e.preventDefault();
        const input = (document.getElementById('admin-password') as HTMLInputElement)?.value;
        if (input === ADMIN_PASS) {
          sessionStorage.setItem(authStorageKey, 'true');
          checkAuth();
        } else {
          if (loginError) {
            loginError.textContent = 'Nieprawidłowe hasło.';
            loginError.classList.remove('hidden');
          }
        }
      });
    }

    if (logoutBtn) {
      logoutBtn.addEventListener('click', () => {
        sessionStorage.removeItem(authStorageKey);
        checkAuth();
      });
    }

    // Przełączanie typu posta (lokalny / Facebook)
    const postSourceSelect = document.getElementById('post-source') as HTMLSelectElement;
    const postAuthorInput = document.getElementById('post-author') as HTMLInputElement;
    const fbPermalinkContainer = document.getElementById('fb-permalink-container');

    postSourceSelect?.addEventListener('change', () => {
      if (postSourceSelect.value === 'facebook') {
        fbPermalinkContainer?.classList.remove('hidden');
        if (postAuthorInput) postAuthorInput.value = '3 SDH Wenedzi (Facebook)';
      } else {
        fbPermalinkContainer?.classList.add('hidden');
        if (postAuthorInput) postAuthorInput.value = 'Drużynowy';
      }
    });

    // Obsługa uploadu zdjęć na Dysk Google
    const driveUploadBtn = document.getElementById('drive-upload-btn') as HTMLButtonElement;
    const driveUploadBtnText = document.getElementById('drive-upload-btn-text');
    const driveUploadDate = document.getElementById('drive-upload-date') as HTMLInputElement;
    const driveUploadFiles = document.getElementById('drive-upload-files') as HTMLInputElement;
    const driveUploadStatus = document.getElementById('drive-upload-status');
    const drivePreviewList = document.getElementById('drive-preview-list');
    const postImagesTextarea = document.getElementById('post-images') as HTMLTextAreaElement;

    // Domyślna data folderu to dzisiejsza data w formacie RRRR.MM.DD
    if (driveUploadDate && !driveUploadDate.value) {
      driveUploadDate.value = new Date().toISOString().slice(0, 10).replace(/-/g, '.');
    }

    driveUploadBtn?.addEventListener('click', async () => {
      const files = driveUploadFiles?.files;
      if (!files || files.length === 0) {
        alert('Wybierz przynajmniej jedno zdjęcie z dysku przed kliknięciem uploadu.');
        return;
      }

      const dateVal = driveUploadDate?.value.trim() || new Date().toISOString().slice(0, 10).replace(/-/g, '.');

      driveUploadBtn.disabled = true;
      if (driveUploadBtnText) driveUploadBtnText.textContent = 'Wgrywanie na Dysk Google...';

      if (driveUploadStatus) {
        driveUploadStatus.className = 'text-xs font-semibold text-emerald-900 p-3 rounded-xl bg-emerald-100 border border-emerald-300 block';
        driveUploadStatus.innerHTML = `⏳ Trwa upload ${files.length} ${files.length === 1 ? 'zdjęcia' : 'zdjęć'} do folderu z datą <strong>${dateVal}</strong> na Dysku Google...`;
        driveUploadStatus.classList.remove('hidden');
      }

      const formData = new FormData();
      formData.append('date', dateVal);
      for (let i = 0; i < files.length; i++) {
        formData.append('files', files[i]);
      }

      try {
        const res = await fetch('/api/drive/upload', {
          method: 'POST',
          body: formData,
        });

        const data = (await res.json()) as any;
        if (data.success && data.files) {
          if (driveUploadStatus) {
            driveUploadStatus.className = 'text-xs font-semibold text-emerald-950 p-3 rounded-xl bg-emerald-100 border border-emerald-300 block';
            driveUploadStatus.innerHTML = `✅ Wgrano ${data.count} ${data.count === 1 ? 'zdjęcie' : 'zdjęć'} do folderu <strong>${data.folderName}</strong> na Dysku Google! Linki dodano do posta poniżej.`;
          }

          // Dopisujemy URL-e do pola post-images
          const newUrls = data.files.map((f: any) => f.proxyUrl);
          const currentVal = postImagesTextarea?.value.trim() || '';
          if (postImagesTextarea) {
            postImagesTextarea.value = currentVal ? `${currentVal}\n${newUrls.join('\n')}` : newUrls.join('\n');
          }

          // Wyświetlamy miniatury w podglądzie
          if (drivePreviewList) {
            drivePreviewList.classList.remove('hidden');
            data.files.forEach((f: any) => {
              const img = document.createElement('img');
              img.src = f.proxyUrl;
              img.alt = f.fileName;
              img.className = 'w-16 h-16 object-cover rounded-xl border border-emerald-300 shadow-xs';
              drivePreviewList.appendChild(img);
            });
          }

          // Reset wyboru plików
          if (driveUploadFiles) driveUploadFiles.value = '';
        } else {
          if (driveUploadStatus) {
            driveUploadStatus.className = 'text-xs font-semibold text-red-800 p-3 rounded-xl bg-red-50 border border-red-200 block';
            driveUploadStatus.textContent = 'Błąd uploadu: ' + (data.error || 'Nie udało się wgrać plików.');
          }
        }
      } catch (err: any) {
        if (driveUploadStatus) {
          driveUploadStatus.className = 'text-xs font-semibold text-red-800 p-3 rounded-xl bg-red-50 border border-red-200 block';
          driveUploadStatus.textContent = 'Błąd połączenia: ' + err.message;
        }
      } finally {
        driveUploadBtn.disabled = false;
        if (driveUploadBtnText) driveUploadBtnText.textContent = 'Wgraj na Dysk Google';
      }
    });

    // Dodawanie nowego posta
    const createPostForm = document.getElementById('create-post-form') as HTMLFormElement;
    createPostForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const source = postSourceSelect?.value || 'local';
      const title = (document.getElementById('post-title') as HTMLInputElement)?.value;
      const fbPermalink = (document.getElementById('post-permalink') as HTMLInputElement)?.value;
      const authorName = (document.getElementById('post-author') as HTMLInputElement)?.value;
      const content = (document.getElementById('post-content') as HTMLTextAreaElement)?.value;
      const isPinned = (document.getElementById('post-pinned') as HTMLInputElement)?.checked;
      const imagesRaw = (document.getElementById('post-images') as HTMLTextAreaElement)?.value;

      const images = imagesRaw
        .split('\n')
        .map((s) => s.trim())
        .filter((s) => s.length > 0 && (s.startsWith('http') || s.startsWith('/')));

      try {
        const res = await fetch('/api/posts', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            source,
            title,
            fbPermalink,
            authorName,
            content,
            isPinned,
            images,
          }),
        });

        const data = await res.json() as any;
        if (data.success) {
          alert('Post został pomyślnie opublikowany!');
          window.location.reload();
        } else {
          alert('Błąd: ' + (data.error || 'Nie udało się dodać posta.'));
        }
      } catch (err: any) {
        alert('Błąd sieciowy: ' + err.message);
      }
    });

    // Synchronizacja z Facebookiem: Pobierz posty z FB
    const syncFbBtn = document.getElementById('sync-fb-btn');
    const syncFbBtnText = document.getElementById('sync-fb-btn-text');
    const fbSyncStatus = document.getElementById('fb-sync-status');

    syncFbBtn?.addEventListener('click', async () => {
      if (syncFbBtnText) syncFbBtnText.textContent = 'Pobieram 5 postów z Facebooka...';
      if (syncFbBtn) (syncFbBtn as HTMLButtonElement).disabled = true;

      if (fbSyncStatus) {
        fbSyncStatus.className = 'p-3 rounded-xl text-xs font-medium bg-blue-50 text-blue-800 block';
        fbSyncStatus.textContent = 'Trwa sprawdzanie fanpage @wenedzi i pobieranie 5 postów wraz ze zdjęciami...';
        fbSyncStatus.classList.remove('hidden');
      }

      try {
        const res = await fetch('/api/sync-fb', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
        });

        const data = await res.json() as any;
        if (data.success) {
          if (fbSyncStatus) {
            fbSyncStatus.className = 'p-3 rounded-xl text-xs font-medium bg-emerald-50 text-emerald-800 block';
            fbSyncStatus.textContent = data.message || 'Pomyślnie zsynchronizowano 5 postów z Facebooka!';
          }
          setTimeout(() => window.location.reload(), 1200);
        } else {
          if (fbSyncStatus) {
            fbSyncStatus.className = 'p-3 rounded-xl text-xs font-medium bg-amber-50 text-amber-900 block';
            fbSyncStatus.textContent = data.message || 'Nie udało się pobrać postów.';
          }
          if (syncFbBtnText) syncFbBtnText.textContent = 'Pobierz posty z FB';
          if (syncFbBtn) (syncFbBtn as HTMLButtonElement).disabled = false;
        }
      } catch (err: any) {
        if (fbSyncStatus) {
          fbSyncStatus.className = 'p-3 rounded-xl text-xs font-medium bg-red-50 text-red-800 block';
          fbSyncStatus.textContent = 'Błąd połączenia: ' + err.message;
        }
        if (syncFbBtnText) syncFbBtnText.textContent = 'Pobierz posty z FB';
        if (syncFbBtn) (syncFbBtn as HTMLButtonElement).disabled = false;
      }
    });

    // Edycja posta lokalnego
    const editModal = document.getElementById('edit-modal');
    const closeEditModalBtn = document.getElementById('close-edit-modal-btn');
    const cancelEditBtn = document.getElementById('cancel-edit-btn');
    const editPostForm = document.getElementById('edit-post-form');
    const editPostId = document.getElementById('edit-post-id') as HTMLInputElement;
    const editPostTitle = document.getElementById('edit-post-title') as HTMLInputElement;
    const editPostAuthor = document.getElementById('edit-post-author') as HTMLInputElement;
    const editPostContent = document.getElementById('edit-post-content') as HTMLTextAreaElement;
    const editPostImages = document.getElementById('edit-post-images') as HTMLTextAreaElement;
    const editPostPinned = document.getElementById('edit-post-pinned') as HTMLInputElement;

    function closeEditModal() {
      editModal?.classList.add('hidden');
      editModal?.classList.remove('flex');
    }

    closeEditModalBtn?.addEventListener('click', closeEditModal);
    cancelEditBtn?.addEventListener('click', closeEditModal);

    document.querySelectorAll('.edit-post-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const id = btn.getAttribute('data-id') || '';
        const title = btn.getAttribute('data-title') || '';
        const author = btn.getAttribute('data-author') || '';
        const content = btn.getAttribute('data-content') || '';
        const pinned = btn.getAttribute('data-pinned') === '1';
        const imagesRaw = btn.getAttribute('data-images') || '';

        let imagesList: string[] = [];
        try {
          if (imagesRaw) imagesList = JSON.parse(imagesRaw);
        } catch {}

        if (editPostId) editPostId.value = id;
        if (editPostTitle) editPostTitle.value = title;
        if (editPostAuthor) editPostAuthor.value = author;
        if (editPostContent) editPostContent.value = content;
        if (editPostPinned) editPostPinned.checked = pinned;
        if (editPostImages) editPostImages.value = imagesList.join('\n');

        editModal?.classList.remove('hidden');
        editModal?.classList.add('flex');
      });
    });

    editPostForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const id = editPostId?.value;
      if (!id) return;

      const title = editPostTitle?.value;
      const authorName = editPostAuthor?.value;
      const content = editPostContent?.value;
      const isPinned = editPostPinned?.checked;
      const images = (editPostImages?.value || '')
        .split('\n')
        .map((s) => s.trim())
        .filter((s) => s.length > 0 && (s.startsWith('http') || s.startsWith('/')));

      try {
        const res = await fetch(`/api/posts/${encodeURIComponent(id)}`, {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ title, authorName, content, isPinned, images }),
        });

        const data = await res.json() as any;
        if (data.success) {
          alert('Post został pomyślnie zaktualizowany!');
          window.location.reload();
        } else {
          alert('Błąd: ' + (data.error || 'Nie udało się zapisać zmian.'));
        }
      } catch (err: any) {
        alert('Błąd sieci: ' + err.message);
      }
    });

    // Usuwanie posta
    document.querySelectorAll('.delete-post-btn').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const id = btn.getAttribute('data-id');
        if (!id) return;

        if (confirm('Czy na pewno chcesz usunąć ten post?')) {
          try {
            const res = await fetch(`/api/posts/${encodeURIComponent(id)}`, {
              method: 'DELETE',
            });
            const data = await res.json() as any;
            if (data.success) {
              const row = btn.closest('tr');
              row?.remove();
            } else {
              alert('Nie udało się usunąć posta.');
            }
          } catch (err: any) {
            alert('Błąd: ' + err.message);
          }
        }
      });
    });

    // Odśwież listę
    document.getElementById('refresh-posts-btn')?.addEventListener('click', () => {
      window.location.reload();
    });

    checkAuth();
  </script>
</Layout>
