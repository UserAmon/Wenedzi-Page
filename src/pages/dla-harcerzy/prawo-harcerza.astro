---
import Layout from '../../layouts/Layout.astro';

const prawa = [
  {
    nr: 1,
    tekst: 'Harcerz służy Bogu i Polsce i sumiennie spełnia swoje obowiązki.',
    komentarz: 'Służba to fundament harcerskiego życia. Oznacza wierność wartościom, ojczyźnie, rodzinie i rzetelność w szkole i w domu.',
  },
  {
    nr: 2,
    tekst: 'Na słowie harcerza polegaj jak na Zawiszy.',
    komentarz: 'Słowo harcerza jest święte. Jeśli coś obiecujesz – dotrzymujesz, bez względu na trudności. Od tego pochodzi czarna barwa w naszej drużynie.',
  },
  {
    nr: 3,
    tekst: 'Harcerz jest pożyteczny i niesie pomoc bliźnim.',
    komentarz: 'Codzienny dobry uczynek to nie formalność, lecz nawyk serca. Rozglądaj się wokół siebie – zawsze ktoś potrzebuje wsparcia.',
  },
  {
    nr: 4,
    tekst: 'Harcerz w każdym widzi bliźniego, a za brata uważa każdego innego harcerza.',
    komentarz: 'Braterstwo łączy wszystkich noszących lilijkę na całym świecie, bez względu na wiek, narodowość czy pochodzenie.',
  },
  {
    nr: 5,
    tekst: 'Harcerz postępuje po rycersku.',
    komentarz: 'Staje w obronie słabszych, jest uprzejmy, szanuje kobiety i starszych, walczy fair play i nie boi się prawdy.',
  },
  {
    nr: 6,
    tekst: 'Harcerz miłuje przyrodę i stara się ją poznać.',
    komentarz: 'Puszczaństwo – zielona barwa Wenedów. Las i przyroda to nasi przyjaciele. Zostawiaj każde miejsce biwakowe czystsze, niż je zastałeś.',
  },
  {
    nr: 7,
    tekst: 'Harcerz jest karny i posłuszny rodzicom i wszystkim swoim przełożonym.',
    komentarz: 'Dyscyplina i posłuszeństwo rozkazom w zastępie i drużynie pozwala działać sprawnie i bezpiecznie w trudnych warunkach.',
  },
  {
    nr: 8,
    tekst: 'Harcerz jest zawsze pogodny.',
    komentarz: 'Pogoda ducha w deszczu, chłodzie i zmęczeniu na szlaku jest znakiem siły charakteru. Uśmiech rozprasza zwątpienie.',
  },
  {
    nr: 9,
    tekst: 'Harcerz jest oszczędny i ofiarny.',
    komentarz: 'Szanuje sprzęt, czas i pieniądze, nie marnuje zasobów, a to co ma – potrafi bez wahania podzielić z potrzebującym bratem.',
  },
  {
    nr: 10,
    tekst: 'Harcerz jest czysty w myśli, mowie i uczynkach; nie pali tytoniu i nie pije napojów alkoholowych.',
    komentarz: 'Wolność od nałogów, szacunek do własnego ciała i umysłu. Harcerz zachowuje jasny umysł i czyste intencje w każdej sytuacji.',
  },
];
---

<Layout title="Prawo Harcerza | 3 SDH »Wenedzi«" description="Prawo i Przyrzeczenie Harcerskie. 10 punktów Prawa Harcerskiego z komentarzem dla harcerzy 3 SDH Wenedzi.">
  <div class="bg-slate-950 text-white py-12 border-b border-slate-800">
    <div class="max-w-4xl mx-auto px-4 sm:px-6">
      <div class="inline-flex items-center gap-2 text-xs font-semibold text-emerald-400 mb-2">
        <a href="/" class="hover:underline">Strona Główna</a>
        <span>/</span>
        <span class="text-slate-400">Dla Harcerzy</span>
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight">
        Prawo i Przyrzeczenie Harcerskie
      </h1>
      <p class="mt-2 text-slate-400 text-sm sm:text-base">
        Kodeks postępowania i drogowskaz każdego harcerza 3 SDH "Wenedzi".
      </p>
    </div>
  </div>

  <div class="max-w-4xl mx-auto px-4 sm:px-6 py-12 space-y-10">
    
    <!-- PRZYRZECZENIE HARCERSKIE -->
    <div class="bg-gradient-to-br from-emerald-950 via-slate-900 to-slate-950 text-white rounded-2xl p-6 sm:p-10 border-2 border-emerald-800 shadow-xl space-y-4 text-center">
      <span class="text-xs font-bold uppercase tracking-widest text-emerald-400 block">
        ⚜️ Rota Przyrzeczenia Harcerskiego
      </span>
      <blockquote class="text-xl sm:text-2xl font-serif italic text-emerald-100 max-w-2xl mx-auto leading-relaxed">
        „Mam szczerą wolę całym życiem pełnić służbę Bogu i Polsce, nieść chętną pomoc bliźnim i być posłusznym Prawu Harcerskiemu.”
      </blockquote>
      <p class="text-xs text-slate-400 pt-2">
        Składane uroczyście przy ognisku obozowym na ręce instruktora harcerskiego.
      </p>
    </div>

    <!-- 10 PUNKTÓW PRAWA HARCERSKIEGO -->
    <section class="space-y-6">
      <h2 class="text-2xl font-bold text-slate-900 flex items-center gap-2">
        <span>Dziesięć Punktów Prawa Harcerskiego</span>
      </h2>

      <div class="space-y-4">
        {prawa.map((p) => (
          <div class="bg-white rounded-2xl p-6 border border-slate-200 shadow-sm hover:border-emerald-700/40 transition-all flex items-start gap-4 sm:gap-6">
            <div class="w-10 h-10 sm:w-12 sm:h-12 rounded-xl bg-emerald-900 text-white font-extrabold flex items-center justify-center text-lg sm:text-xl flex-shrink-0 shadow-inner">
              {p.nr}
            </div>
            <div class="space-y-1.5 flex-1">
              <h3 class="text-base sm:text-lg font-bold text-slate-900 leading-snug">
                {p.tekst}
              </h3>
              <p class="text-sm text-slate-600 leading-relaxed">
                {p.komentarz}
              </p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- HASŁO CZUWAJ -->
    <div class="bg-slate-900 text-white rounded-2xl p-6 sm:p-8 border border-slate-800 text-center space-y-3">
      <h3 class="text-xl font-extrabold text-emerald-400">Harcerskie Pozdrowienie: „CZUWAJ!”</h3>
      <p class="text-sm text-slate-300 max-w-xl mx-auto leading-relaxed">
        Przypomina nam o gotowości do służby, bacznej uwadze na potrzeby innych oraz czuwaniu nad własnym rozwojem i charakterem.
      </p>
    </div>

  </div>
</Layout>
