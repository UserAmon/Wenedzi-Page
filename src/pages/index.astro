---
import Layout from '../layouts/Layout.astro';
import { getAllPosts, type Post } from '../lib/db';

let posts: Post[] = [];
let dbError: string | null = null;

try {
  posts = await getAllPosts(Astro.locals);
} catch (e: any) {
  dbError = e.message;
}

// Formatowanie daty po polsku
function formatDate(dateStr: string) {
  try {
    const d = new Date(dateStr);
    return d.toLocaleDateString('pl-PL', {
      day: 'numeric',
      month: 'long',
      year: 'numeric',
    });
  } catch {
    return dateStr;
  }
}

// Parsowanie zdjęć z JSON
function parseImages(jsonStr: string | null): string[] {
  if (!jsonStr) return [];
  try {
    const parsed = JSON.parse(jsonStr);
    return Array.isArray(parsed) ? parsed : [];
  } catch {
    return [];
  }
}
---

<Layout title="3 SDH »Wenedzi« | 3 Szczecińska Drużyna Harcerzy">
  
  <!-- HERO BANNER -->
  <section class="relative bg-slate-950 text-white overflow-hidden py-16 sm:py-24 border-b border-slate-800">
    <!-- Tło leśne z przyciemnieniem -->
    <div
      class="absolute inset-0 opacity-20 bg-cover bg-center"
      style="background-image: url('https://images.unsplash.com/photo-1478131143081-80f7f84ca84d?auto=format&fit=crop&w=1920&q=80');"
    ></div>
    <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/80 to-transparent"></div>

    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl space-y-6">
        
        <!-- Pigułka barw drużyny -->
        <div class="inline-flex items-center gap-2.5 px-3.5 py-1.5 rounded-full bg-slate-900/90 border border-slate-700/80 backdrop-blur-sm text-xs font-semibold">
          <div class="flex items-center gap-1">
            <span class="w-2.5 h-2.5 rounded-full bg-emerald-600 inline-block shadow-sm"></span>
            <span class="w-2.5 h-2.5 rounded-full bg-slate-950 inline-block border border-slate-600"></span>
            <span class="w-2.5 h-2.5 rounded-full bg-white inline-block shadow-sm"></span>
          </div>
          <span class="text-slate-300">
            Barwy: Zielony (puszczaństwo) • Czarny (Zawisza) • Biały (dobroć)
          </span>
        </div>

        <h1 class="text-3xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight leading-tight">
          3 Szczecińska Drużyna Harcerzy <br />
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-emerald-400 via-emerald-300 to-white">
            "Wenedzi"
          </span>
        </h1>

        <p class="text-base sm:text-lg text-slate-300 leading-relaxed max-w-2xl">
          Braterstwo, leśna droga, służba i niezapomniane przygody. Działamy w Szczecinie, wychowując młodych ludzi w duchu tradycyjnych wartości harcerskich i puszczaństwa.
        </p>

        <!-- Przyciski akcji -->
        <div class="flex flex-wrap gap-3 pt-2">
          <a
            href="/dla-rodzicow/nasza-misja"
            class="px-5 py-3 rounded-xl bg-emerald-700 hover:bg-emerald-600 text-white font-bold text-sm transition-all shadow-lg shadow-emerald-950/50 flex items-center gap-2"
          >
            <span>Dla Rodziców & Nabór</span>
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>
          <a
            href="/dla-harcerzy/spiewnik"
            class="px-5 py-3 rounded-xl bg-slate-900 hover:bg-slate-800 border border-slate-700 text-white font-semibold text-sm transition-all flex items-center gap-2"
          >
            <span>🎸 Śpiewnik & Teoria</span>
          </a>
          <a
            href="https://www.facebook.com/wenedzi/"
            target="_blank"
            rel="noopener noreferrer"
            class="px-4 py-3 rounded-xl bg-slate-900/80 hover:bg-slate-800 text-slate-300 hover:text-white border border-slate-800 font-semibold text-sm transition-all flex items-center gap-2"
          >
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
              <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
            </svg>
            <span>Nasz Facebook</span>
          </a>
        </div>

      </div>
    </div>
  </section>

  <!-- GŁÓWNA TREŚĆ: POSTY + BOCZNY PANEL -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      
      <!-- LEWA KOLUMNA: TABLICA POSTÓW (2 KOLUMNY) -->
      <section class="lg:col-span-2 space-y-6">
        
        <div class="flex flex-col sm:flex-row sm:items-center justify-between pb-4 border-b border-slate-200 gap-4">
          <div>
            <h2 class="text-2xl font-extrabold text-slate-900 flex items-center gap-2.5">
              <span>Aktualności z życia drużyny</span>
            </h2>
            <p class="text-sm text-slate-500 mt-0.5">
              Posty i komunikaty drużyny oraz transmisja na żywo z profilu Facebook
            </p>
          </div>

          <!-- Przełącznik zakładek -->
          <div class="inline-flex p-1 rounded-xl bg-slate-100 border border-slate-200 self-start sm:self-auto text-xs font-bold">
            <button
              type="button"
              id="tab-posts-btn"
              class="px-3.5 py-1.5 rounded-lg bg-emerald-800 text-white shadow-sm transition-all"
            >
              Tablica Drużyny ({posts.length})
            </button>
            <button
              type="button"
              id="tab-fb-btn"
              class="px-3.5 py-1.5 rounded-lg text-slate-600 hover:text-slate-900 transition-all flex items-center gap-1.5"
            >
              <svg class="w-3.5 h-3.5 fill-current text-blue-600" viewBox="0 0 24 24">
                <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
              </svg>
              <span>Na Żywo z Facebooka</span>
            </button>
          </div>
        </div>

        {dbError && (
          <div class="p-4 rounded-xl bg-amber-50 border border-amber-200 text-amber-900 text-sm">
            Uwaga: trwa inicjalizacja bazy danych ({dbError}).
          </div>
        )}

        <!-- KONTENER NA ŻYWO Z FACEBOOKA (BEZPOŚREDNI STREAM BEZ TOKENÓW) -->
        <div id="facebook-live-container" class="hidden bg-white rounded-2xl p-4 sm:p-6 border border-slate-200 shadow-sm space-y-4">
          <div class="flex items-center justify-between pb-3 border-b border-slate-100 flex-wrap gap-2">
            <div class="flex items-center gap-2">
              <span class="w-3 h-3 rounded-full bg-blue-600 animate-ping"></span>
              <span class="font-bold text-slate-900 text-sm">Transmisja najnowszych postów i zdjęć z profilu @wenedzi</span>
            </div>
            <a
              href="https://www.facebook.com/wenedzi/"
              target="_blank"
              rel="noopener noreferrer"
              class="text-xs text-blue-600 hover:underline font-semibold"
            >
              Otwórz fanpage w nowej karcie &rarr;
            </a>
          </div>
          <div class="w-full flex justify-center bg-slate-50 rounded-xl overflow-hidden py-4 border border-slate-100">
            <iframe
              src="https://www.facebook.com/plugins/page.php?href=https%3A%2F%2Fwww.facebook.com%2Fwenedzi&tabs=timeline&width=500&height=800&small_header=false&adapt_container_width=true&hide_cover=false&show_facepile=true&appId"
              width="500"
              height="800"
              style="border:none;overflow:hidden;max-width:100%;min-height:650px;"
              scrolling="yes"
              frameborder="0"
              allowfullscreen="true"
              allow="autoplay; clipboard-write; encrypted-media; picture-in-picture; web-share"
              title="Posty z Facebooka 3 SDH Wenedzi"
              class="rounded-lg shadow-sm"
            ></iframe>
          </div>
          <p class="text-xs text-slate-500 text-center">
            Powyższe okno pobiera posty, zdjęcia i filmy bezpośrednio z serwerów Meta w czasie rzeczywistym.
          </p>
        </div>

        <!-- KONTENER POSTÓW Z BAZY D1 -->
        <div id="posts-container" class="space-y-6">

        {posts.length === 0 ? (
          <div class="bg-white rounded-2xl p-8 border border-slate-200 text-center space-y-3">
            <div class="w-12 h-12 mx-auto rounded-full bg-slate-100 flex items-center justify-center text-slate-400 text-xl">
              🌲
            </div>
            <h3 class="text-lg font-bold text-slate-800">Brak postów do wyświetlenia</h3>
            <p class="text-sm text-slate-500 max-w-sm mx-auto">
              Możesz dodać pierwszy komunikat w panelu administratora lub zsynchronizować posty z Facebooka.
            </p>
            <a
              href="/admin"
              class="inline-block mt-2 px-4 py-2 rounded-lg bg-emerald-800 text-white text-sm font-semibold hover:bg-emerald-700 transition-colors"
            >
              Przejdź do Panelu Admina
            </a>
          </div>
        ) : (
          <div class="space-y-6">
            {posts.map((post) => {
              const images = parseImages(post.images_json);
              const isFacebook = post.source === 'facebook';

              return (
                <article class={`bg-white rounded-2xl border transition-all hover:shadow-md overflow-hidden ${post.is_pinned ? 'border-emerald-600 ring-2 ring-emerald-500/20' : 'border-slate-200'}`}>
                  
                  {/* Górny nagłówek karty posta */}
                  <div class="p-5 sm:p-6 pb-3 flex items-start justify-between gap-4">
                    <div class="flex items-center gap-3">
                      
                      {/* Ikona źródła */}
                      {isFacebook ? (
                        <div class="w-10 h-10 rounded-full bg-blue-50 text-blue-600 flex items-center justify-center flex-shrink-0" title="Post z Facebooka">
                          <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
                            <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
                          </svg>
                        </div>
                      ) : (
                        <div class="w-10 h-10 rounded-full bg-emerald-100 text-emerald-800 flex items-center justify-center flex-shrink-0 font-bold" title="Komunikat drużyny">
                          3
                        </div>
                      )}

                      <div>
                        <div class="flex items-center gap-2">
                          <span class="font-bold text-slate-900 text-sm sm:text-base">
                            {post.author_name || (isFacebook ? '3 SDH Wenedzi (Facebook)' : 'Drużynowy')}
                          </span>
                          
                          {/* Odznaka typu posta */}
                          {isFacebook ? (
                            <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[11px] font-semibold bg-blue-50 text-blue-700">
                              Facebook
                            </span>
                          ) : (
                            <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[11px] font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200">
                              🌲 Komunikat Drużyny
                            </span>
                          )}

                          {Boolean(post.is_pinned) && (
                            <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[11px] font-bold bg-amber-100 text-amber-800">
                              📌 Przypięte
                            </span>
                          )}
                        </div>

                        <time class="text-xs text-slate-400 block mt-0.5">
                          {formatDate(post.created_at)}
                        </time>
                      </div>
                    </div>

                    {isFacebook && post.fb_permalink && (
                      <a
                        href={post.fb_permalink}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="text-xs text-blue-600 hover:text-blue-800 hover:underline flex items-center gap-1 flex-shrink-0 font-medium"
                      >
                        <span>Oryginał</span>
                        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                        </svg>
                      </a>
                    )}
                  </div>

                  {/* Treść posta */}
                  <div class="px-5 sm:px-6 py-2 space-y-3">
                    {post.title && (
                      <h3 class="text-lg sm:text-xl font-bold text-slate-900 leading-snug">
                        {post.title}
                      </h3>
                    )}
                    <div class="text-slate-700 text-sm sm:text-base leading-relaxed whitespace-pre-line">
                      {post.content}
                    </div>
                  </div>

                  {/* Galeria zdjęć w poście */}
                  {images.length > 0 && (
                    <div class="p-4 sm:p-6 pt-3">
                      <div class={`grid gap-2 rounded-xl overflow-hidden ${images.length === 1 ? 'grid-cols-1' : images.length === 2 ? 'grid-cols-2' : 'grid-cols-2 sm:grid-cols-3'}`}>
                        {images.map((imgUrl, idx) => (
                          <div class="relative aspect-video bg-slate-100 overflow-hidden group">
                            <img
                              src={imgUrl}
                              alt={`Zdjęcie ${idx + 1}`}
                              loading="lazy"
                              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                            />
                          </div>
                        ))}
                      </div>
                    </div>
                  )}

                  {/* Pasek stopki posta */}
                  <div class="px-5 sm:px-6 py-3 bg-slate-50 border-t border-slate-100 flex items-center justify-between text-xs text-slate-500">
                    <span>3 Szczecińska Drużyna Harcerzy</span>
                    {isFacebook ? (
                      <a
                        href={post.fb_permalink || 'https://www.facebook.com/wenedzi/'}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="text-blue-600 font-semibold hover:underline"
                      >
                        Skomentuj na Facebooku &rarr;
                      </a>
                    ) : (
                      <span class="text-emerald-700 font-semibold">Czuwaj!</span>
                    )}
                  </div>

                </article>
              );
            })}
          </div>
        )}
        </div>

      </section>

      <!-- PRAWA KOLUMNA: WIDŻETY INFORMACYJNE DLA DRUŻYNY -->
      <aside class="space-y-6">
        
        <!-- Widżet: Najbliższa zbiórka -->
        <div class="bg-gradient-to-br from-emerald-900 to-slate-900 text-white rounded-2xl p-6 shadow-md border border-emerald-800 space-y-4">
          <div class="flex items-center justify-between">
            <span class="text-xs font-bold uppercase tracking-wider text-emerald-400">Termin zbiórek</span>
            <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
          </div>
          <h3 class="text-xl font-extrabold">Najbliższa Zbiórka</h3>
          <p class="text-sm text-slate-300 leading-relaxed">
            Spotykamy się w każdą sobotę. Prosimy o punktualność, pełne umundurowanie oraz spakowany ekwipunek zbiórkowy!
          </p>
          <div class="pt-2 border-t border-emerald-800/80 space-y-2 text-xs">
            <div class="flex items-center gap-2">
              <span class="text-emerald-400">🕒 Kiedy:</span>
              <span class="font-semibold">Sobota, godz. 10:00 – 13:00</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="text-emerald-400">📍 Gdzie:</span>
              <span class="font-semibold">Harcówka / Szczecin</span>
            </div>
          </div>
          <a
            href="/dla-harcerzy/ekwipunek-zbiorki"
            class="block text-center w-full py-2.5 rounded-xl bg-emerald-700 hover:bg-emerald-600 font-bold text-xs transition-colors shadow"
          >
            Sprawdź co spakować na zbiórkę &rarr;
          </a>
        </div>

        <!-- Widżet: Symbolika Barw Drużyny -->
        <div class="bg-white rounded-2xl p-6 border border-slate-200 shadow-sm space-y-3">
          <h4 class="font-extrabold text-slate-900 text-sm tracking-wide uppercase">
            Barwy 3 SDH "Wenedzi"
          </h4>
          <div class="space-y-2.5 text-xs">
            <div class="flex items-start gap-3 p-2.5 rounded-xl bg-emerald-50 border border-emerald-100">
              <span class="w-4 h-4 rounded-full bg-emerald-700 flex-shrink-0 mt-0.5 shadow-sm"></span>
              <div>
                <span class="font-bold text-emerald-950 block">Zielony</span>
                <span class="text-emerald-800">Symbolizuje puszczaństwo, życie w zgodzie z przyrodą i leśną mądrość.</span>
              </div>
            </div>

            <div class="flex items-start gap-3 p-2.5 rounded-xl bg-slate-100 border border-slate-200">
              <span class="w-4 h-4 rounded-full bg-slate-950 flex-shrink-0 mt-0.5 shadow-sm"></span>
              <div>
                <span class="font-bold text-slate-950 block">Czarny</span>
                <span class="text-slate-700">Od Zawiszy Czarnego – wierność słowu, rycerskość i niezłomny honor.</span>
              </div>
            </div>

            <div class="flex items-start gap-3 p-2.5 rounded-xl bg-white border border-slate-200 shadow-inner">
              <span class="w-4 h-4 rounded-full bg-white border border-slate-300 flex-shrink-0 mt-0.5 shadow-sm"></span>
              <div>
                <span class="font-bold text-slate-950 block">Biały</span>
                <span class="text-slate-700">Symbolizuje dobroć, czystość intencji i gotowość do niesienia pomocy.</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Widżet: Szybkie skróty dla rodziców -->
        <div class="bg-white rounded-2xl p-6 border border-slate-200 shadow-sm space-y-4">
          <h4 class="font-extrabold text-slate-900 text-sm tracking-wide uppercase">
            Strefa Rodzica
          </h4>
          <ul class="space-y-2 text-sm">
            <li>
              <a href="/dla-rodzicow/rachunek" class="flex items-center justify-between p-2.5 rounded-xl hover:bg-slate-50 border border-transparent hover:border-slate-200 transition-all font-medium text-slate-700">
                <span>💳 Składki i numer konta</span>
                <span class="text-slate-400">&rarr;</span>
              </a>
            </li>
            <li>
              <a href="/dla-rodzicow/zamowienia" class="flex items-center justify-between p-2.5 rounded-xl hover:bg-slate-50 border border-transparent hover:border-slate-200 transition-all font-medium text-slate-700">
                <span>👔 Mundury i wyposażenie</span>
                <span class="text-slate-400">&rarr;</span>
              </a>
            </li>
            <li>
              <a href="/dla-rodzicow/kontakt" class="flex items-center justify-between p-2.5 rounded-xl hover:bg-slate-50 border border-transparent hover:border-slate-200 transition-all font-medium text-slate-700">
                <span>📞 Kontakt do drużynowego</span>
                <span class="text-slate-400">&rarr;</span>
              </a>
            </li>
          </ul>
        </div>

        <!-- Widżet: Teoria dla harcerzy -->
        <div class="bg-slate-900 text-white rounded-2xl p-6 shadow-sm border border-slate-800 space-y-4">
          <h4 class="font-extrabold text-white text-sm tracking-wide uppercase">
            Baza Wiedzy Harcerza
          </h4>
          <ul class="space-y-2 text-xs">
            <li>
              <a href="/dla-harcerzy/prawo-harcerza" class="block p-2 rounded-lg bg-slate-800/80 hover:bg-slate-800 transition-colors">
                ⚜️ <strong>Prawo i Przyrzeczenie</strong> – 10 punktów Prawa
              </a>
            </li>
            <li>
              <a href="/dla-harcerzy/spiewnik" class="block p-2 rounded-lg bg-slate-800/80 hover:bg-slate-800 transition-colors">
                🎸 <strong>Śpiewnik z chwytami</strong> – piosenki przy ognisku
              </a>
            </li>
            <li>
              <a href="/dla-harcerzy/ekwipunek-obozy" class="block p-2 rounded-lg bg-slate-800/80 hover:bg-slate-800 transition-colors">
                🌲 <strong>Wyprawka obozowa</strong> – interaktywna checklista
              </a>
            </li>
          </ul>
        </div>

      </aside>

    </div>
  </div>

  <script>
    const tabPostsBtn = document.getElementById('tab-posts-btn');
    const tabFbBtn = document.getElementById('tab-fb-btn');
    const postsContainer = document.getElementById('posts-container');
    const fbContainer = document.getElementById('facebook-live-container');

    if (tabPostsBtn && tabFbBtn && postsContainer && fbContainer) {
      tabPostsBtn.addEventListener('click', () => {
        tabPostsBtn.className = 'px-3.5 py-1.5 rounded-lg bg-emerald-800 text-white shadow-sm transition-all';
        tabFbBtn.className = 'px-3.5 py-1.5 rounded-lg text-slate-600 hover:text-slate-900 transition-all flex items-center gap-1.5';
        postsContainer.classList.remove('hidden');
        fbContainer.classList.add('hidden');
      });

      tabFbBtn.addEventListener('click', () => {
        tabFbBtn.className = 'px-3.5 py-1.5 rounded-lg bg-blue-600 text-white shadow-sm transition-all flex items-center gap-1.5';
        tabPostsBtn.className = 'px-3.5 py-1.5 rounded-lg text-slate-600 hover:text-slate-900 transition-all';
        fbContainer.classList.remove('hidden');
        postsContainer.classList.add('hidden');
      });
    }
  </script>

</Layout>
